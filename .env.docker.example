# Copy to .env.docker and adjust secrets before `docker compose up`.
# DATABASE_URL is set by compose to point at the `db` service — do not override unless you know why.

HTTP_PORT=8080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platewire

PIPELINE_ENABLED=true

WINLINE_MLB_URL=https://winline.ru/stavki/sport/bejsbol/ssha/mlb
WINLINE_BASEBALL_URL=https://winline.ru/stavki/sport/bejsbol
FETCH_CONCURRENCY=3
ODDS_FETCH_RETRIES=3
ODDS_RETRY_DELAY_SECONDS=1.5

JWT_SECRET=change-me-in-production-platewire
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=baseballai_bot
TELEGRAM_NOTIFY_ENABLED=true
TELEGRAM_NOTIFY_CHAT_IDS=

AI_ENABLED=true
AI_BASE_URL=https://ollama.com
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_TOOL_ROUNDS=6
AI_DECISION_MODEL=glm-5.2:cloud
AI_DECISION_TEMPERATURE=0.1
AI_CURATION_MODEL=glm-5.2:cloud
AI_CURATION_TEMPERATURE=0.3
AI_CURATION_CRON_ENABLED=true
