# Copy to .env.docker and adjust secrets before `docker compose up`.
# DATABASE_URL is set by compose to point at the `db` service — do not override unless you know why.

# Local: 8080. On the VPS with this domain, use 80 so the host works without :port.
HTTP_PORT=80
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platewire

PIPELINE_ENABLED=true

WINLINE_MLB_URL=https://winline.ru/stavki/sport/bejsbol/ssha/mlb
WINLINE_BASEBALL_URL=https://winline.ru/stavki/sport/bejsbol
FETCH_CONCURRENCY=3
ODDS_FETCH_RETRIES=3
ODDS_RETRY_DELAY_SECONDS=1.5

JWT_SECRET=change-me-in-production-platewire
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Path secret: /mcp/$MCP_SERVICE_TOKEN. Empty disables the route.
MCP_SERVICE_TOKEN=yfB-svqAuNHDxcSX7M8OaQ0hKMBBGxsug8zJQX7CEHY

# Office dispatcher: the collector POSTs a game event here, the office webhook
# starts one Hermes worker for that game. Secret must equal PLATEWIRE_WEBHOOK_SECRET
# in desk/.env.office. Empty disables office events (collector logs a warning).
HERMES_WEBHOOK_URL=http://127.0.0.1:8645/webhooks/platewire
HERMES_WEBHOOK_SECRET=
