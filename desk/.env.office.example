# Office runtime env for the VPS supervisor. Copy to desk/.env.office and adjust.
# This file is gitignored (.env.*) — never commit real values.

# Where the collector API listens (loopback only on the server).
PLATEWIRE_BASE_URL=http://127.0.0.1:8000/api/v1
PLATEWIRE_LOGIN=admin
PLATEWIRE_PASSWORD=change-me

# Hermes home of the office agent — the cashier reads TELEGRAM_BOT_TOKEN from
# $HERMES_HOME/.env (see cashier._hermes_env_path).
HERMES_HOME=/home/platewire/.hermes
# Optional explicit override, wins over HERMES_HOME.
# PLATEWIRE_HERMES_ENV=/home/platewire/.hermes/.env
# Optional model for the bet note (_explain.py).
# PLATEWIRE_EXPLAIN_MODEL=deepseek-v4.1-flash

# Local paths, all under /opt/platewire.
PLATEWIRE_RUNTIME=/opt/platewire/desk/runtime
# PLATEWIRE_SKIP_TELEGRAM=1 disables group messages (smoke tests only).

# Office dispatcher. The collector runs in a container on the same host, so the
# listener must accept connections from the docker bridge — 0.0.0.0 plus an
# interface-scoped firewall rule for the bridge subnet (never the public iface).
PLATEWIRE_WEBHOOK_HOST=0.0.0.0
PLATEWIRE_PYTHON=/usr/bin/python3
PLATEWIRE_AGENT_TIMEOUT=900
PLATEWIRE_WORKER_TIMEOUT=600
